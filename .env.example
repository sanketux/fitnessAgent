# Copy to .env and fill in, or export these in your shell.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# FITNESS_AGENT_MODEL=claude-sonnet-5   # or claude-opus-5 for the stronger model
# FITNESS_AGENT_DB=data/fitness.db
# FITNESS_AGENT_CONTEXT=context/sanket_health_agent_context.md
# FITNESS_AGENT_EFFORT=medium

# Telegram bot (fitness-agent-telegram). Get the token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your numeric Telegram user id. Leave empty on first run: the bot replies with your id.
TELEGRAM_ALLOWED_USER_IDS=
# Daily check-in reminder in FITNESS_AGENT_TZ local time, or empty to disable.
TELEGRAM_CHECKIN_TIME=21:00
